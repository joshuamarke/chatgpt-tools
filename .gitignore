# Dependencies
node_modules/

# Build / output
dist/
build/
out/
# Staged production skins (only default skin(s); created by stage-bundle-skins.mjs)
bundle-resources/
*.exe
*.dll
*.pdb

# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/
# Package-time secrets (cloud URL / updater endpoints) — never commit
src-tauri/gen/release-config.json
src-tauri/gen/tauri.release-overlay.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Tauri updater signing private key (public key lives in tauri.conf.json)
keys/*.key
!keys/*.key.pub
!keys/README.md
# Production cloud / updater endpoints (same secrecy class as private keys)
keys/release.env
!keys/release.env.example

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Test / coverage
coverage/
.nyc_output/

# Misc
*.local
.cache/

# Local notes / scratch (not part of the product tree)
说明.md
*.scratch.*
tmp/
temp/

# Local one-off CDP probes, skin patches, dumps (dev-only; do not commit)
scripts/local/
scripts/probe-*.mjs
scripts/probe-*-out*
scripts/*-out.json.txt
scripts/*-out.txt
scripts/finish-*.mjs
scripts/patch-*.mjs
scripts/scope-*.mjs
