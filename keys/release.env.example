# Production cloud / updater endpoints — package-time only.
# Copy to keys/release.env (gitignored) or set the same names as CI Secrets.
# NEVER commit real private values.

# ── Updater (应用内「检查更新」) ──────────────────────────────────────────
# Optional override. If empty, build auto-uses GitHub Releases:
#   https://github.com/<owner>/<repo>/releases/latest/download/latest.json
# (from GITHUB_REPOSITORY in CI, or src/repo-meta.json owner/name locally)
#
# Default (also auto-filled from src/repo-meta.json when empty):
# TAURI_UPDATER_ENDPOINTS=https://github.com/joshuamarke/chatgpt-tools/releases/latest/download/latest.json
#
# Multiple endpoints (comma-separated) — first = highest priority; later = fallback:
# TAURI_UPDATER_ENDPOINTS=https://cdn.example.com/chatgpt-tools/latest.json,https://github.com/joshuamarke/chatgpt-tools/releases/latest/download/latest.json
TAURI_UPDATER_ENDPOINTS=

# ── Cloud catalog (optional) ─────────────────────────────────────────────
# Skin CDN / packages API. Leave empty if you only ship bundled skins + GitHub.
# Formal open-source releases do NOT require this.
CODEX_SKIN_CLOUD_URL=

# Optional extra allowlist hosts (comma-separated)
CODEX_SKIN_CLOUD_EXTRA_HOSTS=
