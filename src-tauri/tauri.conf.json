{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Tools",
  "version": "1.1.12",
  "identifier": "com.chatgpt.tools",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/stage-bundle-skins.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT Tools",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine": "engine",
      "../bundle-resources/skins": "skins",
      "../src/logo.png": "logo.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true,
    "longDescription": "ChatGPT Tools — lightweight non-invasive skin manager for ChatGPT / Codex desktop via local CDP.",
    "shortDescription": "ChatGPT Tools skin manager",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQzVEOTIzQjBDQkM4RTgKUldUb3lNdXdJOW5GelozRHpzakZ0bDN3eFk1cXFaMmhkSHVkMlpUbDlQZWN2TmVCVi9xbkJiMzkK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
